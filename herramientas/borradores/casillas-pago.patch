+-- Migración 43 (5-nov-2026, pedido de la abogada): constancia de que la clienta marcó la casilla «sin derecho de retracto»
+-- al pagar un amigurumi personalizado. PREPARADA, SIN APLICAR: se aplica junto con el despliegue de crear-pago-wompi cuando el chat 6 confirme el texto.
+-- Solo agrega dos columnas opcionales; no cambia permisos ni datos existentes (la tabla ya tiene RLS cerrado).
+alter table public.pedidos_web
+  add column if not exists acepta_sin_retracto_at timestamptz,
+  add column if not exists acepta_sin_retracto_version text;
+comment on column public.pedidos_web.acepta_sin_retracto_at is 'Hora del servidor en que la clienta marcó la casilla de personalizado sin retracto';
+-- Reversa: alter table public.pedidos_web drop column acepta_sin_retracto_at, drop column acepta_sin_retracto_version;
