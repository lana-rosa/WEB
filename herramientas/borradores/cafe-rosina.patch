+<script>
+// Invítale un café a Rosina: elegir el valor, copiar la llave y avisar por WhatsApp
+(function () {
+  var botones = document.querySelectorAll('.cafe-opciones button');
+  var wa = document.getElementById('cafe-whatsapp');
+  if (!wa) return;
+  function formato(v) { return '$' + Number(v).toLocaleString('es-CO'); }
+  function elegir(b) {
+    botones.forEach(function (x) { var on = x === b; x.classList.toggle('activa', on); x.setAttribute('aria-pressed', on); });
+    wa.href = 'https://wa.me/573205072801?text=' + encodeURIComponent('Hola Rosina 🐑☕ Te acabo de invitar un café de ' + formato(b.dataset.valor) + ' desde el Rincón de Rosina. ¡Gracias por el material!');
+  }
+  botones.forEach(function (b) { b.addEventListener('click', function () { elegir(b); }); });
+  elegir(document.querySelector('.cafe-opciones button.activa'));
+  var copiar = document.getElementById('cafe-copiar');
+  copiar.addEventListener('click', function () {
+    var ok = function () { copiar.textContent = '¡Copiada!'; setTimeout(function () { copiar.textContent = 'Copiar'; }, 1500); };
+    try { navigator.clipboard.writeText('3205072801').then(ok, ok); } catch (e) { ok(); }
+  });
+})();
+</script>
